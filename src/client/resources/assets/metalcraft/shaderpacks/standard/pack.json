{
  "format": 2,
  "name": "MetalCraft Standard",
  "includes": ["shared/options.metal", "shared/shadows.metal", "shared/lighting.metal", "shared/local_lights.metal", "shared/water.metal", "shared/underwater.metal", "shared/sky.metal", "shared/wind.metal"],
  "targets": {
    "gbuffer_albedo": {
      "format": "rgba8_unorm",
      "scale": 1.0,
      "lifetime": "transient"
    },
    "gbuffer_normal": {
      "format": "rgba8_unorm",
      "scale": 1.0,
      "lifetime": "transient"
    },
    "gbuffer_light": {
      "format": "rgba8_unorm",
      "scale": 1.0,
      "lifetime": "transient"
    },
    "post_color": {
      "format": "bgra8_unorm",
      "scale": 1.0,
      "lifetime": "frame"
    }
  },
  "passes": [
    {
      "id": "gbuffer",
      "kind": "geometry",
      "source": "gbuffer.metal",
      "geometry": "terrain,entities,blockentities",
      "writes": ["scene", "gbuffer_albedo", "gbuffer_normal", "gbuffer_light", "depth"]
    },
    {
      "id": "resolve",
      "kind": "fullscreen",
      "source": "resolve.metal",
      "merge_with": "gbuffer",
      "tile_reads": ["scene", "gbuffer_albedo", "gbuffer_normal", "gbuffer_light"],
      "reads": ["shadow_map"],
      "buffers": ["shadow_frame"],
      "writes": ["scene"]
    },
    {
      "id": "grade",
      "kind": "fullscreen",
      "source": "grade.metal",
      "reads": ["scene"],
      "buffers": ["underwater_frame"],
      "writes": ["post_color"]
    }
  ],
  "options": [
    {
      "id": "local_lights",
      "category": "shadows",
      "type": "bool",
      "default": true,
      "apply": "recompile"
    },
    {
      "id": "exposure",
      "category": "tonemap",
      "type": "float",
      "min": 0.25,
      "max": 4.0,
      "step": 0.05,
      "default": 1.0,
      "apply": "uniform"
    },
    {
      "id": "tonemap",
      "category": "tonemap",
      "type": "enum",
      "values": ["none", "aces", "reinhard"],
      "default": "none",
      "apply": "uniform"
    },
    {
      "id": "debug_view",
      "category": "debug",
      "type": "enum",
      "values": ["off", "scene", "albedo", "normal", "light", "receiver", "cascade", "visibility", "vanilla", "local_visibility"],
      "default": "off",
      "apply": "uniform"
    },
    {
      "id": "shadow_strength",
      "category": "shadows",
      "type": "float",
      "min": 0.5,
      "max": 2.5,
      "step": 0.25,
      "default": 1.0,
      "apply": "uniform"
    },
    {
      "id": "invert",
      "category": "debug",
      "type": "bool",
      "default": false,
      "apply": "recompile"
    },
    {
      "id": "shadow_cascades",
      "category": "shadows",
      "type": "int",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4,
      "apply": "recompile"
    },
    {
      "id": "shadow_resolution",
      "category": "shadows",
      "type": "int",
      "min": 256,
      "max": 4096,
      "step": 256,
      "default": 1024,
      "apply": "recompile"
    },
    {
      "id": "shadow_distance",
      "category": "shadows",
      "type": "int",
      "min": 32,
      "max": 256,
      "step": 16,
      "default": 96,
      "apply": "recompile"
    },
    {
      "id": "distant_shadow_distance",
      "category": "shadows",
      "type": "int",
      "min": 0,
      "max": 512,
      "step": 32,
      "default": 256,
      "apply": "recompile"
    },
    {
      "id": "shadow_caster_distance",
      "category": "shadows",
      "type": "int",
      "min": 0,
      "max": 256,
      "step": 16,
      "default": 96,
      "apply": "recompile"
    },
    {
      "id": "water_enabled",
      "category": "water",
      "type": "bool",
      "default": true,
      "apply": "recompile"
    },
    {
      "id": "water_detail",
      "category": "water",
      "type": "int",
      "min": 0,
      "max": 3,
      "step": 1,
      "default": 2,
      "apply": "recompile"
    },
    {
      "id": "water_detail_distance",
      "category": "water",
      "type": "int",
      "min": 2,
      "max": 32,
      "step": 1,
      "default": 16,
      "apply": "recompile"
    },
    {
      "id": "water_wave_strength",
      "category": "water",
      "type": "float",
      "min": 0.0,
      "max": 1.0,
      "step": 0.1,
      "default": 1.0,
      "apply": "recompile"
    },
    {
      "id": "water_refraction_strength",
      "category": "water",
      "type": "float",
      "min": 0.0,
      "max": 1.0,
      "step": 0.1,
      "default": 1.0,
      "apply": "recompile"
    },
    {
      "id": "water_absorption",
      "category": "water",
      "type": "float",
      "min": 0.0,
      "max": 1.0,
      "step": 0.1,
      "default": 1.0,
      "apply": "recompile"
    },
    {
      "id": "water_foam",
      "category": "water",
      "type": "float",
      "min": 0.0,
      "max": 1.0,
      "step": 0.1,
      "default": 1.0,
      "apply": "recompile"
    },
    {
      "id": "water_underwater_distortion",
      "category": "water",
      "type": "float",
      "min": 0.0,
      "max": 1.0,
      "step": 0.1,
      "default": 1.0,
      "apply": "recompile"
    },
    {
      "id": "water_reflection_quality",
      "category": "water",
      "type": "enum",
      "values": [
        "off",
        "baseline",
        "ssr_low",
        "ssr_high"
      ],
      "default": "baseline",
      "apply": "recompile"
    },
    {
      "id": "wind_enabled",
      "category": "wind",
      "type": "bool",
      "default": true,
      "apply": "recompile"
    },
    {
      "id": "wind_strength",
      "category": "wind",
      "type": "float",
      "min": 0.0,
      "max": 2.0,
      "step": 0.25,
      "default": 1.0,
      "apply": "recompile"
    },
    {
      "id": "temperature",
      "category": "tonemap",
      "type": "float",
      "min": -1.0,
      "max": 1.0,
      "step": 0.05,
      "default": 0.0,
      "apply": "uniform"
    },
    {
      "id": "tint",
      "category": "tonemap",
      "type": "float",
      "min": -1.0,
      "max": 1.0,
      "step": 0.05,
      "default": 0.0,
      "apply": "uniform"
    },
    {
      "id": "contrast",
      "category": "tonemap",
      "type": "float",
      "min": 0.5,
      "max": 1.5,
      "step": 0.05,
      "default": 1.0,
      "apply": "uniform"
    },
    {
      "id": "saturation",
      "category": "tonemap",
      "type": "float",
      "min": 0.0,
      "max": 2.0,
      "step": 0.05,
      "default": 1.0,
      "apply": "uniform"
    },
    {
      "id": "vibrance",
      "category": "tonemap",
      "type": "float",
      "min": -1.0,
      "max": 1.0,
      "step": 0.05,
      "default": 0.0,
      "apply": "uniform"
    },
    {
      "id": "gamma",
      "category": "tonemap",
      "type": "float",
      "min": 0.5,
      "max": 2.0,
      "step": 0.05,
      "default": 1.0,
      "apply": "uniform"
    },
    {
      "id": "highlights",
      "category": "tonemap",
      "type": "float",
      "min": -1.0,
      "max": 1.0,
      "step": 0.05,
      "default": 0.0,
      "apply": "uniform"
    },
    {
      "id": "shadows",
      "category": "tonemap",
      "type": "float",
      "min": -1.0,
      "max": 1.0,
      "step": 0.05,
      "default": 0.0,
      "apply": "uniform"
    },
    {
      "id": "film_grain",
      "category": "tonemap",
      "type": "int",
      "min": 0,
      "max": 3,
      "step": 1,
      "default": 0,
      "apply": "uniform"
    },
    {
      "id": "bloom",
      "category": "tonemap",
      "type": "int",
      "min": 0,
      "max": 3,
      "step": 1,
      "default": 0,
      "apply": "uniform"
    },
    {
      "id": "depth_of_field",
      "category": "tonemap",
      "type": "int",
      "min": 0,
      "max": 3,
      "step": 1,
      "default": 0,
      "apply": "uniform"
    }
  ]
}
