{
  "format": 1,
  "name": "MetalCraft Standard",
  "targets": {
    "gbuffer_albedo": {
      "format": "rgba8_unorm",
      "scale": 1.0,
      "lifetime": "frame"
    },
    "gbuffer_normal": {
      "format": "rgba8_unorm",
      "scale": 1.0,
      "lifetime": "frame"
    },
    "gbuffer_light": {
      "format": "rgba8_unorm",
      "scale": 1.0,
      "lifetime": "frame"
    }
  },
  "passes": [
    {
      "id": "gbuffer",
      "kind": "geometry",
      "geometry": "terrain,entities,blockentities",
      "writes": ["scene", "gbuffer_albedo", "gbuffer_normal", "gbuffer_light", "depth"]
    },
    {
      "id": "final",
      "kind": "fullscreen",
      "reads": ["scene", "gbuffer_albedo", "gbuffer_normal", "gbuffer_light", "depth"],
      "writes": ["drawable"]
    }
  ],
  "options": [
    {
      "id": "debug_view",
      "category": "debug",
      "type": "enum",
      "values": ["off", "albedo", "normal", "light", "material", "depth"],
      "default": "off",
      "apply": "uniform"
    },
    {
      "id": "exposure",
      "category": "tonemap",
      "type": "float",
      "min": 0.5,
      "max": 2.0,
      "step": 0.25,
      "default": 1.0,
      "apply": "uniform"
    },
    {
      "id": "invert",
      "category": "tonemap",
      "type": "bool",
      "default": false,
      "apply": "recompile"
    },
    {
      "id": "upscale_filter",
      "category": "quality",
      "type": "enum",
      "values": ["nearest", "linear"],
      "default": "linear",
      "apply": "reload"
    }
  ]
}
