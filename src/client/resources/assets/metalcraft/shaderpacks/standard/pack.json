{
  "format": 1,
  "name": "MetalCraft Standard",
  "targets": {
    "gbuffer_albedo": {
      "format": "rgba8_unorm",
      "scale": 1.0,
      "lifetime": "transient"
    },
    "gbuffer_normal": {
      "format": "rgba8_unorm",
      "scale": 1.0,
      "lifetime": "transient"
    },
    "gbuffer_light": {
      "format": "rgba8_unorm",
      "scale": 1.0,
      "lifetime": "transient"
    },
    "shadow": {
      "format": "depth32_float",
      "size": 2048,
      "layers": 4,
      "lifetime": "frame"
    },
    "ssao": {
      "format": "r8_unorm",
      "scale": 0.5,
      "lifetime": "frame"
    },
    "bloom_half": {
      "format": "rgba16_float",
      "scale": 0.5,
      "lifetime": "frame"
    },
    "bloom_quarter": {
      "format": "rgba16_float",
      "scale": 0.25,
      "lifetime": "frame"
    },
    "bloom": {
      "format": "rgba16_float",
      "scale": 0.5,
      "lifetime": "frame"
    },
    "volumetric": {
      "format": "rgba16_float",
      "scale": 0.5,
      "lifetime": "frame"
    },
    "post_color": {
      "format": "rgba16_float",
      "scale": 1.0,
      "lifetime": "frame"
    }
  },
  "passes": [
    {
      "id": "shadow",
      "kind": "shadow",
      "geometry": "terrain,entities,blockentities",
      "writes": ["shadow"]
    },
    {
      "id": "gbuffer",
      "kind": "geometry",
      "geometry": "terrain,entities,blockentities",
      "writes": ["scene", "gbuffer_albedo", "gbuffer_normal", "gbuffer_light", "depth"]
    },
    {
      "id": "resolve",
      "kind": "fullscreen",
      "merge_with": "gbuffer",
      "reads": ["shadow"],
      "tile_reads": ["scene", "gbuffer_albedo", "gbuffer_normal", "gbuffer_light"],
      "writes": ["scene"]
    },
    {
      "id": "ssao",
      "kind": "compute",
      "enabled_by": "ssao",
      "reads": ["depth"],
      "writes": ["ssao"]
    },
    {
      "id": "bloom_down_half",
      "kind": "compute",
      "enabled_by": "bloom",
      "reads": ["scene"],
      "writes": ["bloom_half"]
    },
    {
      "id": "bloom_down_quarter",
      "kind": "compute",
      "enabled_by": "bloom",
      "reads": ["bloom_half"],
      "writes": ["bloom_quarter"]
    },
    {
      "id": "bloom_up",
      "kind": "compute",
      "enabled_by": "bloom",
      "reads": ["bloom_half", "bloom_quarter"],
      "writes": ["bloom"]
    },
    {
      "id": "volumetrics",
      "kind": "compute",
      "enabled_by": "volumetrics",
      "reads": ["depth", "shadow"],
      "writes": ["volumetric"]
    },
    {
      "id": "grade",
      "kind": "fullscreen",
      "reads": ["scene", "ssao", "bloom", "volumetric"],
      "writes": ["post_color"]
    },
    {
      "id": "final",
      "kind": "fullscreen",
      "reads": ["post_color"],
      "writes": ["drawable"]
    }
  ],
  "options": [
    {
      "id": "debug_view",
      "category": "debug",
      "type": "enum",
      "values": ["off", "albedo", "normal", "light", "material", "depth", "shadow0", "shadow1", "shadow2", "shadow3"],
      "default": "off",
      "apply": "uniform"
    },
    {
      "id": "exposure",
      "category": "tonemap",
      "type": "float",
      "min": 0.5,
      "max": 2.0,
      "step": 0.25,
      "default": 1.0,
      "apply": "uniform"
    },
    {
      "id": "invert",
      "category": "tonemap",
      "type": "bool",
      "default": false,
      "apply": "recompile"
    },
    {
      "id": "upscale_filter",
      "category": "quality",
      "type": "enum",
      "values": ["nearest", "linear", "metalfx"],
      "default": "metalfx",
      "apply": "reload"
    },
    {
      "id": "shadow_resolution",
      "category": "shadows",
      "type": "enum",
      "values": [1024, 2048, 4096],
      "default": 2048,
      "apply": "reload"
    },
    {
      "id": "shadow_distance",
      "category": "shadows",
      "type": "int",
      "min": 64,
      "max": 512,
      "step": 32,
      "default": 192,
      "apply": "uniform"
    },
    {
      "id": "shadow_normal_offset",
      "category": "shadows",
      "type": "float",
      "min": 0.0,
      "max": 0.5,
      "step": 0.01,
      "default": 0.08,
      "apply": "uniform"
    },
    {
      "id": "ssao",
      "category": "lighting",
      "type": "bool",
      "default": true,
      "apply": "uniform"
    },
    {
      "id": "ssao_strength",
      "category": "lighting",
      "type": "float",
      "min": 0.0,
      "max": 2.0,
      "step": 0.1,
      "default": 0.8,
      "apply": "uniform"
    },
    {
      "id": "bloom",
      "category": "lighting",
      "type": "bool",
      "default": true,
      "apply": "uniform"
    },
    {
      "id": "bloom_strength",
      "category": "lighting",
      "type": "float",
      "min": 0.0,
      "max": 2.0,
      "step": 0.05,
      "default": 0.25,
      "apply": "uniform"
    },
    {
      "id": "volumetrics",
      "category": "lighting",
      "type": "bool",
      "default": true,
      "apply": "uniform"
    },
    {
      "id": "volumetric_strength",
      "category": "lighting",
      "type": "float",
      "min": 0.0,
      "max": 2.0,
      "step": 0.05,
      "default": 0.35,
      "apply": "uniform"
    },
    {
      "id": "tonemap",
      "category": "tonemap",
      "type": "enum",
      "values": ["none", "aces"],
      "default": "aces",
      "apply": "uniform"
    },
    {
      "id": "saturation",
      "category": "tonemap",
      "type": "float",
      "min": 0.0,
      "max": 2.0,
      "step": 0.05,
      "default": 1.0,
      "apply": "uniform"
    },
    {
      "id": "contrast",
      "category": "tonemap",
      "type": "float",
      "min": 0.5,
      "max": 1.5,
      "step": 0.05,
      "default": 1.0,
      "apply": "uniform"
    },
    {
      "id": "temperature",
      "category": "tonemap",
      "type": "float",
      "min": -1.0,
      "max": 1.0,
      "step": 0.1,
      "default": 0.0,
      "apply": "uniform"
    }
  ]
}
